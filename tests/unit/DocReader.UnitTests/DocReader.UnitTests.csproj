<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DocReader.UnitTests</RootNamespace>
    <!-- xunit.v3 runs on Microsoft.Testing.Platform, which is what dotnet test uses on the .NET 10
         SDK. The VSTest bridge is deliberately absent. -->
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\DocReader.Application\DocReader.Application.csproj" />
    <ProjectReference Include="..\..\..\src\DocReader.Domain\DocReader.Domain.csproj" />
    <ProjectReference Include="..\..\..\src\DocReader.Infrastructure\DocReader.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\samples\synthetic\**\*" Link="samples/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- OCR real das amostras da Etapa 3, capturado por scripts/capture-ocr-fixtures.py. -->
    <Content Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
