# Copy to .env and adjust. No real secret belongs in this file or in .env: the PoC runs locally with
# throwaway credentials.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------------------------
# Published ports
# ---------------------------------------------------------------------------------------------
# Interface and BFF.
WEB_PORT=3000
# API and Swagger.
API_PORT=8080

# Only used by docker-compose.dev.yml, which publishes the database and the OCR service.
POSTGRES_PORT=5432
OCR_PORT=8001

# ---------------------------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------------------------
POSTGRES_DB=docreader
POSTGRES_USER=docreader
# Local throwaway password. Change it before running anywhere that is not your own machine.
POSTGRES_PASSWORD=docreader

# ---------------------------------------------------------------------------------------------
# Upload limits (RF-002)
# ---------------------------------------------------------------------------------------------
# 25 MB.
UPLOAD_MAX_SIZE_BYTES=26214400
UPLOAD_MAX_PAGE_COUNT=50

# ---------------------------------------------------------------------------------------------
# Idempotency-Key retention (section 16 of the PRD)
# ---------------------------------------------------------------------------------------------
# How long a key stays bound to its file hash and to the response it produced. Format d.hh:mm:ss or
# hh:mm:ss.
IDEMPOTENCY_KEY_TTL=24:00:00

# ---------------------------------------------------------------------------------------------
# Anonymous access (section 4 of the PRD)
# ---------------------------------------------------------------------------------------------
# true: anyone who reaches the application can upload, list, view, download and delete.
# false: /api/v1 answers 503, because this PoC ships no authentication provider to fall back to.
ALLOW_ANONYMOUS_ACCESS=true

# ---------------------------------------------------------------------------------------------
# Enterprise SSO for the API (ADR 0003)
# ---------------------------------------------------------------------------------------------
# Empty (the default): anonymous mode, unchanged. ALLOW_ANONYMOUS_ACCESS above is what gates /api/v1.
# Set to a real OIDC issuer (a Keycloak realm URL, an Azure AD tenant, ...) to turn on JWT bearer
# validation: every endpoint then requires a valid bearer token, and ALLOW_ANONYMOUS_ACCESS stops
# applying (the JWT challenge is the gate then). Example: http://keycloak:8080/realms/docreader.
OIDC_AUTHORITY=
# This API's client id at the provider. Also used as the expected token audience.
OIDC_CLIENT_ID=
# Role required by the three /api/v1/admin endpoints (backup, restore, storage migration).
OIDC_ADMIN_ROLE=docreader-admin
# Role granted to every ordinary authenticated user. Not enforced by any endpoint yet.
OIDC_USER_ROLE=docreader-user

# ---------------------------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------------------------
# Production or Development.
ASPNETCORE_ENVIRONMENT=Production
OCR_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------------------------
# OCR service (stage 2, ADR 0002)
# ---------------------------------------------------------------------------------------------
# Memory ceiling of the container. The measured peak of PP-OCRv5 on CPU is about 2.3 GB.
OCR_MEMORY_LIMIT=3g
# Detector and recognizer. ppocrv5-mobile is the default and the only one whose models are baked into the
# image. ppocrv6-small / ppocrv6-tiny are 2-8x faster and read less (ADR 0002, follow-up of 2026-09-25):
# use them only knowingly, and note that another profile downloads its models on first start.
OCR_MODEL_PROFILE=ppocrv5-mobile
# Inference slots. 1 is what the memory ceiling was sized for; raise both together.
OCR_MAX_CONCURRENCY=1
# Wall clock budget of one page inside the service (seconds), waiting for a slot included.
OCR_PAGE_TIMEOUT_SECONDS=120
# Budget of one page as seen by the worker. Keep it above OCR_PAGE_TIMEOUT_SECONDS.
OCR_WORKER_PAGE_TIMEOUT=00:02:30
# CPU threads of the inference.
OCR_THREADS=4
# PDF rasterization resolution and the largest image side, in pixels, that goes to the detector.
OCR_PDF_DPI=200
OCR_MAX_IMAGE_SIDE=3200
# oneDNN acceleration. Only valid with the paddlepaddle build pinned in services/ocr-service/requirements.txt.
OCR_ENABLE_MKLDNN=true
# PDF pages with a real text layer are read from it, without rasterization or OCR (RF-009). Minimum
# letters and digits for the layer to count; below it (empty layer, page number) the page goes to OCR.
OCR_PDF_NATIVE_TEXT_MIN_CHARS=20
# Turn sideways or upside-down pages upright and straighten small tilts before OCR (RF-009). Tilts
# below the minimum are left alone; above the maximum they are treated as a detection error.
OCR_ORIENTATION_CORRECTION=true
OCR_DESKEW_MIN_DEGREES=0.5
OCR_DESKEW_MAX_DEGREES=20
# PP-StructureV3 on demand for a suspected table with low PP-OCRv5 confidence (RF-009). Off by default.
# When on: SET OCR_MEMORY_LIMIT=6g (the PP-StructureV3 child peaks at 2.9 GB on an A4 page, on top of
# the service; below that it is killed and the page keeps PP-OCRv5), expect 27-40 s more per table page,
# and ~873 MB of models downloaded into the model cache at the first start. The ADR 0002 OOM at 1.17 MP
# came from PP-StructureV3's default server models; with the mobile ones it reads a 3.87 MP A4 page
# (addendum of 2026-09-29), hence 4.0. A clean table PP-OCRv5 reads at 0.99 does not trigger at 0.80;
# 1.0 sends every page that looks like a table.
OCR_USE_PP_STRUCTUREV3_FOR_TABLES=false
OCR_STRUCTURE_MAX_MEGAPIXELS=4.0
OCR_STRUCTURE_TABLE_CONFIDENCE_THRESHOLD=0.80

# ---------------------------------------------------------------------------------------------
# Job queue (RF-007, ADR 0002)
# ---------------------------------------------------------------------------------------------
# Attempts before a transient failure becomes definitive, and the first retry delay (doubles each time).
QUEUE_MAX_ATTEMPTS=3
QUEUE_RETRY_BASE_DELAY=00:00:15
# Silence after which a job is taken from its worker. The worker renews the lock after every page, so
# this is not a limit on the document. It must be greater than OCR_WORKER_PAGE_TIMEOUT.
QUEUE_JOB_LOCK_TIMEOUT=00:05:00

# ---------------------------------------------------------------------------------------------
# Storage repositories
# ---------------------------------------------------------------------------------------------
# Key that encrypts the connection settings of the storage repositories (AES-256-GCM): Base64 of exactly 32 bytes.
# API and worker must share it. The value below only keeps the local demo working: it is public, so generate
# your own for anything else with `openssl rand -base64 32`. Losing the key loses the stored settings.
STORAGE_CONFIG_ENCRYPTION_KEY=ZG9jcmVhZGVyLWxvY2FsLWRlbW8ta2V5LTMyYnl0ZXM=

# ---------------------------------------------------------------------------------------------
# Webhooks
# ---------------------------------------------------------------------------------------------
# A webhook is a request the worker makes to whatever URL a subscription names, from inside your network. By default
# a URL that points at localhost, a private range (10.x, 172.16-31.x, 192.168.x, the Docker network) or a link-local
# address (including the cloud metadata address) is refused, when it is registered and again when the worker connects.
# Set it to true only to test against a receiver on your own machine or network.
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false

# ---------------------------------------------------------------------------------------------
# Retention
# ---------------------------------------------------------------------------------------------
# When the worker purges the documents whose retention period ended: it removes the original file, the text the OCR
# read and the extracted fields, and marks the document PURGED (the record and its timeline stay). Five-field cron expression, evaluated in UTC. The default is 02:00 every day.
# Use "* * * * *" to test (every minute). The retention itself is set in /api/v1/retention-policies.
PURGE_SCHEDULE_CRON=0 2 * * *

# ---------------------------------------------------------------------------------------------
# Classification
# ---------------------------------------------------------------------------------------------
# Minimum score, between 0 and 1, for a document type to be accepted. 0 keeps the threshold of each
# type (0.6). Lower it to classify documents with weaker evidence (more recall, more risk of a wrong
# type); raise it to accept only strong evidence. Reprocess a document to apply a change. GET
# /api/v1/documents/{id}/classification-diagnostics shows the score of every type.
CLASSIFICATION_MIN_SCORE=0
